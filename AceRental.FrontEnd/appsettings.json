{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "RemFrontendReverseProxy": {
        "Routes": {
            "rem-route": {
                "ClusterId": "rem-gw-cluster",
                "Match": {
                    "Path": "/api/acerental/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/acerental/api/{**catch-all}"
                    }
                ]
            },
            "referentiel-route": {
                "ClusterId": "rem-gw-cluster",
                "Match": {
                    "Path": "/api/referentiel/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/referentiel/api/{**catch-all}"
                    }
                ]
            },
            "identity-route": {
                "ClusterId": "identity-gw-cluster",
                "Match": {
                    "Path": "api/identity/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "identity/api/{**catch-all}"
                    }
                ]
            },
            "identity-front-route": {
                "ClusterId": "identity-gw-cluster",
                "Match": {
                    "Path": "api/identity-front/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "identity-front/api/{**catch-all}"
                    }
                ]
            }
        },
        "Clusters": {
            "rem-gw-cluster": {
                "Destinations": {
                    "admin-destination": {
                        "Address": "http://acerental-gw:1001"
                    }
                }
            },
            "identity-gw-cluster": {
                "Destinations": {
                    "identity-destination": {
                        "Address": "http://identity-gw:8080"
                    }
                }
            }
        }
    },
    "FrontUrl": "http://acerental-angular:4200",
    "AllowedHosts": "*"
}
