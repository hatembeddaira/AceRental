{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AceFrontendReverseProxy": {
    "Routes": {
      "Ace-route": {
        "ClusterId": "Ace-gw-cluster",
        "Match": {
          "Path": "/api/acerental/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/acerental/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "Ace-gw-cluster": {
        "Destinations": {
          "admin-destination": {
            "Address": "http://acerental-gw:1001"
          }
        }
      }
    }
  },

  "FrontUrl": "http://localhost:4200",
  "AllowedHosts": "*"
}
