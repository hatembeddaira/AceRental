@Api_HostAddress = http://localhost:5000
@ReservationId = 18565498-4450-4dff-bda7-4918674c16f5

### Create Reservation
POST {{Api_HostAddress}}/Api/v1/Reservations/
Content-Type: application/json

{
  "clientId": "60c39f88-d53f-467b-9789-007a1110d7a5",
  "startDate": "2026-03-09T18:00:00.000Z",
  "endDate": "2026-03-10T03:00:00.000Z",
  "workflow": 1,
  "Equipments":[],
  "packs": [
    {
      "packId": "aaa9776b-5789-41f2-bab7-29566e9a5e50",
      "quantity": 1   
    }
  ],
  "services": [
    {
      "serviceId": "db7d35d8-2536-4743-8b59-c17e3b5a3024",
      "quantity": 1    
    },
    {
      "serviceId": "3a02a0df-6c7c-4241-bc04-b2292b9fa0db",
      "quantity": 1     
    },
    {
      "serviceId": "29a180bb-854f-4da5-9929-a31c4c77fa55",
      "quantity": 1 ,
      "PriceHT": 50    
    }
  ]
}


### Update Reservation Date and qte
PATCH {{Api_HostAddress}}/Api/v1/Reservations({{ReservationId}})
Content-Type: application/json

{
  "workflow": 1,
  "Equipments":[],
  "packs": [
    {
      "packId": "805119c5-0e83-432d-9d79-baed5f7a6065",
      "quantity": 1   
    }
  ],
  "services": [
    {
      "serviceId": "ef53ed80-167e-4219-a0b9-f3c40d952be3",
      "quantity": 1    
    },
    {
      "serviceId": "c63debcf-5368-4d82-ae58-7fc097ee96b6",
      "quantity": 1     
    },
    {
      "serviceId": "411d0441-780c-4d43-97e7-ae7eb6bc1125",
      "quantity": 1 ,
      "PriceHT": 50    
    }
  ]
}

### Update Reservation qte
PATCH {{Api_HostAddress}}/Api/v1/Reservations({{ReservationId}})
Content-Type: application/json

{
  "packs": [
    {
      "packId": "fe70da20-d25a-411b-9e52-9055481ef31d",
      "quantity": 1   
    }
  ],
  "equipments": [
    {
      "equipmentId": "41f64f47-41b0-4dfc-ab45-1f3cf1187516",
      "quantity": 1      
    }
  ],
  "services": [
    {
      "serviceId": "3b1102cc-1551-47c9-aca0-9704d0311067",
      "quantity": 2,
      "unitPriceAtTimeOfBooking":0      
    }
  ]
}

### Cancel Reservation
PATCH {{Api_HostAddress}}/Api/v1/Reservations({{ReservationId}})/LogisticStatus
Content-Type: application/json

{
  "status": 4
}

### Get Reservation
GET {{Api_HostAddress}}/Api/v1/Reservations({{ReservationId}})?$expand=Client,Packs,Equipments,Services
Content-Type: application/json

### Get All Reservation
GET {{Api_HostAddress}}/Api/v1/Reservations?$expand=Client,Payments,Quotes,Invoices,Services,Packs,Equipments
Content-Type: application/json


### Get All Reservation for Client
GET {{Api_HostAddress}}/Api/v1/Reservations?$filter=ClientId eq 60c39f88-d53f-467b-9789-007a1110d7a5&$expand=Client,Payments,Quotes($expand=QuoteLines),Invoices,Services,Packs,Equipments
Content-Type: application/json

