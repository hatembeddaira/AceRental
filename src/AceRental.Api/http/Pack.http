      "equipmentId": "fbc5b7ab-f72b-43f3-81a7-0153d78370d3",
      "quantity": 2   
    },
    {
      "equipmentId": "6928fb9c-ac4d-4f77-b867-69641ed131b4",
      "quantity": 1      
    },
    {
      "equipmentId": "aa330552-1777-4750-b479-1f68f671badf",
      "quantity": 2    
    }
  ]
}

