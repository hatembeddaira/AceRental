@Api_HostAddress = http://localhost:5000

### Create Pack
POST {{Api_HostAddress}}/Api/v1/Packs/
Content-Type: application/json

{
  "reference": "SOL",
  "name": "Pack SOL",
  "description": "Pack de deux enceintes en facade et deux retours et une console analogique",
  "dailyPriceHT": 300,
  "items": [
    {
      "equipmentId": "20ff66f9-323a-487b-afcc-ded80b101866",
      "quantity": 2   
    },
    {
      "equipmentId": "0394d635-58d3-4e34-8ff6-4f963ebcbd97",
      "quantity": 2      
    },
    {
      "equipmentId": "9285e5bf-a47c-4c46-aeed-872eb73788c1",
      "quantity": 1      
    }
  ]
}

